class_name Flipbook
## Rebuilds and streams the animation from the atlas generated by the baker.
extends Node2D

## Shader that rebuilds the normal from its RG channels.
const SHADER: Shader = preload("normal_from_rg.gdshader")

## Set the atlas resource produced by the baker.
@export var atlas: FlipbookAtlas
## Set the buffering window seconds, from one tick to the animation duration.
@export var buffer_seconds: float = 1.0

## Directory of the diffuse pages.
var _dir_diffuse: String = ""
## Directory of the normal pages.
var _dir_normal: String = ""
## Slot index sequences grouped by frame, in the draw order that rebuilds it.
var _frames: Array[PackedInt32Array] = []
## Number of frames of the animation.
var _frame_count: int = 0
## Page indices used by each frame.
var _frame_pages: Array[PackedInt32Array] = []
## Number of columns and rows in a frame.
var _frame_grid := Vector2i.ZERO
## Index of the frame currently on screen.
var _current_frame: int = -1
## Width and height of a tile, in diffuse pixels.
var _tile_px := Vector2i.ZERO
## Gutter per side in diffuse pixels.
var _gutter: int = 0
## Width and height of a slot, core tile plus gutter.
var _slot_px := Vector2i.ZERO
## Slots per page, total.
var _slots_per_page: int = 0
## Number of columns and rows in a page.
var _page_grid := Vector2i.ZERO
## Diffuse texture and material with the normal of each page in the buffer, by page index.
var _resident_pages: Dictionary[int, Array] = {}
## Index of the page being loaded.
var _load_page: int = -1
## Number of frames kept ready in the buffer.
var _buffer_size: int = 0
## True when the buffer holds the whole animation.
var _is_resident: bool = false
## True while the initial buffer is filling up.
var _is_prerolling: bool = true
## Page indices of the initial buffer, in order of need.
var _preroll_pages := PackedInt32Array()
## Number of pages of the initial buffer.
var _preroll_count: int = 0
## Position in the initial buffer of the next page to request.
var _preroll_next: int = 0
## Cells on screen, each showing the tile cut out of one slot of the current frame.
var _cells: Array[Sprite2D] = []
## Number of cells that make up a frame.
var _cell_count: int = 0
## Index of the slot currently applied to each cell.
var _cell_slots := PackedInt32Array()
## Animation frames drawn each second.
var _tick_rate: int = 24
## Real time between two ticks.
var _tick_period: float = 0.0
## Current tick along the timeline.
var _tick: int = 0
## Real time since the last tick.
var _since_tick: float = 0.0


## Called when the node enters the scene tree for the first time.
func _ready() -> void:
	@warning_ignore_start("integer_division")
	_dir_diffuse = atlas.dir_diffuse
	_dir_normal = atlas.dir_normal
	_frame_grid = atlas.frame_grid
	_frames = atlas.frames
	_tile_px = atlas.tile_px
	_gutter = atlas.gutter
	_slot_px = atlas.slot_px
	_slots_per_page = atlas.slots_per_page
	_page_grid = atlas.page_grid
	_tick_rate = atlas.tick_rate
	
	# Precalculate the frame count, tick period and buffer size.
	_frame_count = _frames.size()
	_tick_period = 1.0 / _tick_rate
	_buffer_size = int(buffer_seconds * _tick_rate)
	_is_resident = _buffer_size == _frame_count
	
	# Precalculate the pages that each frame uses.
	for frame in _frames:
		var pages: Dictionary[int, bool] = {}
		for slot in frame:
			pages[slot / _slots_per_page] = true
		_frame_pages.append(PackedInt32Array(pages.keys()))
	
	# Precalculate the pages of the initial buffer, in order of need.
	var preroll: Dictionary[int, bool] = {}
	for i in _buffer_size:
		for page in _frame_pages[i]:
			preroll[page] = true
	_preroll_pages = PackedInt32Array(preroll.keys())
	_preroll_count = _preroll_pages.size()
	
	# Build the sprite cells that will host the slots.
	for cy in _frame_grid.y:
		for cx in _frame_grid.x:
			var cell := Sprite2D.new()
			cell.centered = false
			cell.position = Vector2(cx * _tile_px.x, cy * _tile_px.y)
			cell.region_enabled = true
			add_child(cell)
			_cells.append(cell)
	_cell_count = _cells.size()
	_cell_slots.resize(_cell_count)
	_cell_slots.fill(-1)
	@warning_ignore_restore("integer_division")


## Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	@warning_ignore_start("integer_division")
	
	# Fill up the initial buffer, loading the pages its frames need.
	if _is_prerolling:
		if _load_page == -1:
			if _preroll_next == _preroll_count:
				_is_prerolling = false
				return
			_request_page(_preroll_pages[_preroll_next])
			_preroll_next += 1
		_collect_page()
		return
	
	# Keep the sliding buffer filled, loading the pages its frames need.
	if not _is_resident:
		if _load_page == -1:
			for i in _buffer_size:
				for page in _frame_pages[(_tick + i) % _frame_count]:
					if _load_page == -1 and not _resident_pages.has(page):
						_request_page(page)
		if _load_page != -1:
			_collect_page()
	
	# Apply the current frame once ready, pointing its changed cells: no pixels are moved.
	if _tick != _current_frame:
		var is_ready: bool = true
		for page in _frame_pages[_tick]:
			if not _resident_pages.has(page):
				is_ready = false
		if is_ready:
			var slots: PackedInt32Array = _frames[_tick]
			for i in _cell_count:
				var slot: int = slots[i]
				if slot != _cell_slots[i]:
					var page: int = slot / _slots_per_page
					var slot_pos: int = slot % _slots_per_page
					var cell: Sprite2D = _cells[i]
					var page_res: Array = _resident_pages[page]
					cell.texture = page_res[0]
					cell.material = page_res[1]
					cell.region_rect = Rect2(
							(slot_pos % _page_grid.x) * _slot_px.x + _gutter,
							(slot_pos / _page_grid.x) * _slot_px.y + _gutter,
							_tile_px.x, _tile_px.y)
					_cell_slots[i] = slot
			_current_frame = _tick
	
	# Advance the animation clock on real time.
	_since_tick += delta
	if _since_tick >= _tick_period:
		_since_tick -= _tick_period
		_tick = (_tick + 1) % _frame_count
		
		# Release the pages not used by any frame of the buffer.
		if not _is_resident:
			var needed: Dictionary[int, bool] = {}
			for i in _buffer_size:
				for page in _frame_pages[(_tick + i) % _frame_count]:
					needed[page] = true
			for k in _resident_pages.keys():
				if not needed.has(k):
					_resident_pages.erase(k)
	@warning_ignore_restore("integer_division")


## Called to start loading a page, its diffuse and normal textures.
func _request_page(page: int) -> void:
	ResourceLoader.load_threaded_request(_page_path(_dir_diffuse, page))
	ResourceLoader.load_threaded_request(_page_path(_dir_normal, page))
	_load_page = page


## Called to build the path of a page inside its directory.
func _page_path(dir: String, page: int) -> String:
	return dir.path_join("page_%03d.png" % page)


## Called with a page loading to collect it once ready, building its material.
func _collect_page() -> void:
	var path_d: String = _page_path(_dir_diffuse, _load_page)
	var path_n: String = _page_path(_dir_normal, _load_page)
	var status_d := ResourceLoader.load_threaded_get_status(path_d)
	var status_n := ResourceLoader.load_threaded_get_status(path_n)
	if (
			status_d == ResourceLoader.THREAD_LOAD_LOADED
			and status_n == ResourceLoader.THREAD_LOAD_LOADED
	):
		var mat := ShaderMaterial.new()
		mat.shader = SHADER
		mat.set_shader_parameter("normal_rg", ResourceLoader.load_threaded_get(path_n))
		_resident_pages[_load_page] = [ResourceLoader.load_threaded_get(path_d), mat]
		_load_page = -1
